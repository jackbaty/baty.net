---
layout: layouts/base.njk
bodyClass: home
eleventyExcludeFromCollections: true
pagination:
  data: collections.everything
  size: 20
  alias: items
permalink: "{% if pagination.pageNumber == 0 %}/{% else %}/page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---
<div class="container">
  {% if pagination.pageNumber == 0 %}
  <div class="welcome-header">
    <h2 class="welcome-title">A blog about everything, by Jack Baty</h2>
    <p class="welcome-bio">Director of Unspecified Services.<br>Amateur photographer, blogger, and curious nerd.</p>
    <nav class="welcome-social" aria-label="Social links">
      <a href="mailto:jack@baty.net" title="Email" aria-label="Email">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </a>
      <a href="https://social.lol/@jbaty" title="Mastodon" rel="me" aria-label="Mastodon">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.327 8.566c0-4.339-2.843-5.61-2.843-5.61-1.433-.658-3.894-.935-6.451-.956h-.063c-2.557.021-5.016.298-6.45.956 0 0-2.843 1.272-2.843 5.61 0 .993-.019 2.181.012 3.441.103 4.243.778 8.425 4.701 9.463 1.809.479 3.362.579 4.612.51 2.268-.126 3.541-.809 3.541-.809l-.075-1.646s-1.621.511-3.441.449c-1.804-.062-3.707-.194-3.999-2.409a4.523 4.523 0 0 1-.04-.621s1.77.433 4.014.536c1.372.063 2.658-.08 3.965-.236 2.506-.299 4.688-1.843 4.962-3.254.434-2.223.398-5.424.398-5.424zm-3.353 5.59h-2.081V9.057c0-1.075-.452-1.62-1.357-1.62-1 0-1.501.647-1.501 1.927v2.791h-2.069V9.364c0-1.28-.501-1.927-1.502-1.927-.905 0-1.357.546-1.357 1.62v5.099H6.026V8.903c0-1.074.273-1.927.823-2.558.566-.631 1.307-.955 2.228-.955 1.065 0 1.872.409 2.405 1.228l.518.869.519-.869c.533-.819 1.34-1.228 2.4-1.228.921 0 1.662.324 2.228.955.549.631.822 1.484.822 2.558v5.253z"/></svg>
      </a>
      <a href="https://flickr.com/photos/jbaty" title="Flickr" aria-label="Flickr">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="7.5" cy="12" r="4.5"/><circle cx="16.5" cy="12" r="4.5"/></svg>
      </a>
      <a href="/index.xml" title="RSS" aria-label="RSS">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
      </a>
    </nav>
  </div>
  {% endif %}

  <section class="post-list" aria-label="Recent posts">

    {% for item in items %}

      {% if item.data.type == "post" %}
        {# ── POST ─────────────────────────────────────── #}
        <article class="post-card">
          <div class="post-meta">
            <time datetime="{{ item.date | htmlDateString }}">{{ item.date | readableDate }}</time>
            {% for tag in item.data.tags %}
              {% if tag and tag != "posts" and tag != "journal" and tag != "notes" %}
                <a href="/tags/{{ tag | slug }}/" class="tag">{{ tag }}</a>
              {% endif %}
            {% endfor %}
          </div>
          <h2 class="post-title">
            <a href="{{ item.url }}">{{ item.data.title }}</a>
          </h2>
          {% if item.data.cover and item.data.cover.src %}
            <figure class="post-cover">
              <img src="{{ item.data.cover.src }}" alt="{{ item.data.cover.alt | default('') }}">
              {% if item.data.cover.caption %}<figcaption>{{ item.data.cover.caption }}</figcaption>{% endif %}
            </figure>
          {% endif %}
          {% if item.templateContent | hasMore %}
            <div class="post-body">{{ item.templateContent | excerpt | safe }}</div>
            <a href="{{ item.url }}" class="post-permalink">Read more →</a>
          {% else %}
            <div class="post-body">{{ item.templateContent | safe }}</div>
            <a href="{{ item.url }}" class="post-permalink">Permalink #</a>
          {% endif %}
        </article>

      {% elif item.data.type == "journal" %}
        {# ── JOURNAL ───────────────────────────────────── #}
        <article class="post-card">
          <div class="post-meta">
            <time datetime="{{ item.date | htmlDateString }}">{{ item.date | readableDate }}</time>
          </div>
          <h2 class="post-title">
            <a href="{{ item.url }}">{{ item.data.title }}</a>
          </h2>
          {% if item.data.cover and item.data.cover.src %}
            <figure class="post-cover">
              <img src="{{ item.data.cover.src }}" alt="{{ item.data.cover.alt | default('') }}">
              {% if item.data.cover.caption %}<figcaption>{{ item.data.cover.caption }}</figcaption>{% endif %}
            </figure>
          {% endif %}
          <div class="post-body">{{ item.templateContent | safe }}</div>
        </article>

      {% elif item.data.type == "note" %}
        {# ── NOTE ─────────────────────────────────────── #}
        <article class="post-card post-card--note">
          <div class="post-meta">
            <time datetime="{{ item.date | htmlDateString }}">
              <a href="{{ item.url }}">{{ item.date | readableDate }} #</a>
            </time>
          </div>
          <div class="post-body">{{ item.templateContent | safe }}</div>
        </article>

      {% endif %}

    {% endfor %}

  </section>

  {% if pagination.pages.length > 1 %}
    <nav class="pagination" aria-label="Page navigation">
      {% if pagination.href.previous %}
        <a href="{{ pagination.href.previous }}" class="pagination-prev">← Newer</a>
      {% endif %}
      {% if pagination.href.next %}
        <a href="{{ pagination.href.next }}" class="pagination-next">Older →</a>
      {% endif %}
    </nav>
  {% endif %}
</div>
