---
layout: layouts/base.njk
---
<div class="container">
  <article>
    <header class="post-header">
      <div class="post-meta">
        <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
      </div>
      {% if title %}
        <h1 class="post-title">{{ title }}</h1>
      {% else %}
        <h1 class="post-title">Note — {{ date | readableDate }}</h1>
      {% endif %}
    </header>
    <div class="post-body">
      {{ content | safe }}
    </div>
  </article>
</div>
