---
layout: layouts/base.njk
---
<div class="container">
  <article>
    <header class="post-header">
      <div class="post-meta">
        <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
      </div>
      {% if title %}
        <h1 class="post-title">{{ title }}</h1>
      {% else %}
        <h1 class="post-title">Note — {{ date | readableDate }}</h1>
      {% endif %}
    </header>
    {% if thumb %}
      <img src="{{ thumb }}" alt="" class="post-thumb" aria-hidden="true">
    {% endif %}
    <div class="post-body">
      {{ content | safe }}
    </div>
    <footer class="reply-footer">
      <a class="reply-email" href="mailto:{{ site.email }}?subject=[Baty.net] Re: {{ (title if title else ("Note — " + (date | readableDate))) | urlencode }}">✍️ Reply by email</a>
    </footer>
  </article>
</div>
