---
layout: layouts/base.njk
---
<div class="container">
  <article>
    <header class="post-header">
      <div class="post-meta">
        <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
        {% for tag in tags %}
          {% if tag and tag != "posts" and tag != "journal" and tag != "notes" %}
            <a href="/tags/{{ tag | slug }}/" class="tag">{{ tag }}</a>
          {% endif %}
        {% endfor %}
      </div>
      <h1 class="post-title">{{ title }}</h1>
      {% if subtitle %}<p class="page-subtitle">{{ subtitle }}</p>{% endif %}
      {% if cover and cover.src and not cover.hidden %}
        <figure class="post-cover">
          <img src="{{ cover.src }}" alt="{{ cover.alt | default('') }}">
          {% if cover.caption %}<figcaption>{{ cover.caption }}</figcaption>{% endif %}
        </figure>
      {% endif %}
    </header>
    <div class="post-body">
      {{ content | safe }}
    </div>
    <footer class="reply-footer">
      <a class="reply-email" href="mailto:{{ site.email }}?subject=[Baty.net] Re: {{ title | urlencode }}">✍️ Reply by email</a>
    </footer>
  </article>
</div>
