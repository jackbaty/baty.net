---
layout: layouts/base.njk
title: Posts
subtitle: A link to every post, all on one page.
permalink: /posts/
eleventyExcludeFromCollections: true
---
<div class="container">
  <header class="page-header">
    <h1 class="page-title">Posts</h1>
    {% if subtitle %}<p class="page-subtitle">{{ subtitle }}</p>{% endif %}
  </header>
  <ul class="post-archive">
    {% set currentYear = "" %}
    {% for post in collections.posts %}
      {% set postYear = post.date | year %}
      {% if postYear != currentYear %}
        {% set currentYear = postYear %}
        <li class="archive-year"><span>{{ currentYear }}</span></li>
      {% endif %}
      <li>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
        <time datetime="{{ post.date | htmlDateString }}">{{ post.date | shortDate }}</time>
      </li>
    {% endfor %}
  </ul>
</div>
