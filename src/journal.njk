---
layout: layouts/base.njk
title: Journal
subtitle: Daily notes. One per day. Most days.
eleventyExcludeFromCollections: true
pagination:
  data: collections.journal
  size: 20
  alias: items
permalink: "{% if pagination.pageNumber == 0 %}/journal/{% else %}/journal/page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---
<div class="container">
  <header class="page-header">
    <h1 class="page-title">Journal</h1>
    {% if subtitle and pagination.pageNumber == 0 %}<p class="page-subtitle">{{ subtitle }}</p>{% endif %}
  </header>
  <section class="post-list">
    {% for item in items %}
      <article class="post-card">
        <div class="post-meta">
          <time datetime="{{ item.date | htmlDateString }}">{{ item.date | readableDate }}</time>
        </div>
        <h2 class="post-title">
          <a href="{{ item.url }}">{{ item.data.title }}</a>
        </h2>
        {% if item.data.cover and item.data.cover.src %}
          <figure class="post-cover">
            <img src="{{ item.data.cover.src }}" alt="{{ item.data.cover.alt | default('') }}">
            {% if item.data.cover.caption %}<figcaption>{{ item.data.cover.caption }}</figcaption>{% endif %}
          </figure>
        {% endif %}
        <div class="post-body">{{ item.templateContent | safe }}</div>
      </article>
    {% endfor %}
  </section>
  {% if pagination.pages.length > 1 %}
    <nav class="pagination" aria-label="Page navigation">
      {% if pagination.href.previous %}
        <a href="{{ pagination.href.previous }}" class="pagination-prev">← Newer</a>
      {% endif %}
      {% if pagination.href.next %}
        <a href="{{ pagination.href.next }}" class="pagination-next">Older →</a>
      {% endif %}
    </nav>
  {% endif %}
</div>
