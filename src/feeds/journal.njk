---
permalink: /journal/index.xml
templateEngineOverride: njk
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }} — Journal</title>
  <link href="{{ site.url }}/journal/index.xml" rel="self"/>
  <link href="{{ site.url }}/journal/"/>
  {% if collections.journal.length %}
  <updated>{{ collections.journal[0].date | dateToRfc3339 }}</updated>
  {% endif %}
  <id>{{ site.url }}/journal/</id>
  <author><name>{{ site.author }}</name><email>jack@baty.net</email></author>
  {% for item in collections.journal | head(20) %}
  <entry>
    <title>{{ item.data.title | escape }}</title>
    <link href="{{ item.url | absoluteUrl(site.url) }}"/>
    <id>{{ item.url | absoluteUrl(site.url) }}</id>
    <updated>{{ item.date | dateToRfc3339 }}</updated>
    <content type="html"><![CDATA[{% if item.data.cover and item.data.cover.src and not item.data.cover.hidden %}<figure><img src="{{ site.url }}{{ item.data.cover.src }}" alt="{{ item.data.cover.alt | default('') }}">{% if item.data.cover.caption %}<figcaption>{{ item.data.cover.caption }}</figcaption>{% endif %}</figure>{% endif %}{{ item.templateContent | safe }}<p><a href="mailto:{{ site.email }}?subject=[Baty.net] Re: {{ item.data.title | urlencode }}">✍️ Reply by email</a></p>]]></content>
  </entry>
  {% endfor %}
</feed>
