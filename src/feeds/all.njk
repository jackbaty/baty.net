---
permalink: /index.xml
templateEngineOverride: njk
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title>
  <link href="{{ site.url }}/index.xml" rel="self"/>
  <link href="{{ site.url }}/"/>
  {% if collections.everything.length %}
  <updated>{{ collections.everything[0].date | dateToRfc3339 }}</updated>
  {% endif %}
  <id>{{ site.url }}/</id>
  <author><name>{{ site.author }}</name><email>jack@baty.net</email></author>
  {% for item in collections.everything | head(20) %}
  {% set absolutePostUrl = item.url | absoluteUrl(site.url) %}
  <entry>
    <title>{% if item.data.title %}{{ item.data.title | escape }}{% else %}Note — {{ item.date | readableDate }}{% endif %}</title>
    <link href="{{ absolutePostUrl }}"/>
    <id>{{ absolutePostUrl }}</id>
    <updated>{{ item.date | dateToRfc3339 }}</updated>
    <content type="html"><![CDATA[{% if item.data.cover and item.data.cover.src and not item.data.cover.hidden %}<figure><img src="{{ site.url }}{{ item.data.cover.src }}" alt="{{ item.data.cover.alt | default('') }}">{% if item.data.cover.caption %}<figcaption>{{ item.data.cover.caption }}</figcaption>{% endif %}</figure>{% endif %}{{ item.templateContent | htmlToAbsoluteUrls(absolutePostUrl) | safe }}<p><a href="mailto:{{ site.email }}?subject=[Baty.net] Re: {{ (item.data.title if item.data.title else ("Note — " + (item.date | readableDate))) | urlencode }}">✍️ Reply by email</a></p>]]></content>
  </entry>
  {% endfor %}
</feed>
