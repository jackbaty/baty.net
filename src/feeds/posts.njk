---
permalink: /posts/index.xml
templateEngineOverride: njk
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }} — Posts</title>
  <link href="{{ site.url }}/posts/index.xml" rel="self"/>
  <link href="{{ site.url }}/posts/"/>
  {% if collections.posts.length %}
  <updated>{{ collections.posts[0].date | dateToRfc3339 }}</updated>
  {% endif %}
  <id>{{ site.url }}/posts/</id>
  <author><name>{{ site.author }}</name></author>
  {% for item in collections.posts | head(20) %}
  <entry>
    <title>{{ item.data.title | escape }}</title>
    <link href="{{ item.url | absoluteUrl(site.url) }}"/>
    <id>{{ item.url | absoluteUrl(site.url) }}</id>
    <updated>{{ item.date | dateToRfc3339 }}</updated>
    <content type="html"><![CDATA[{% if item.data.cover and item.data.cover.src and not item.data.cover.hidden %}<figure><img src="{{ site.url }}{{ item.data.cover.src }}" alt="{{ item.data.cover.alt | default('') }}">{% if item.data.cover.caption %}<figcaption>{{ item.data.cover.caption }}</figcaption>{% endif %}</figure>{% endif %}{{ item.templateContent | safe }}]]></content>
  </entry>
  {% endfor %}
</feed>
